    <diagram id="xRdoTwZvirdtfvDg6jgX" name="Page-1">
        <mxGraphModel dx="1136" dy="521" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1920" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="59" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=7;" parent="1" vertex="1">
                    <mxGeometry x="20" y="500" width="560" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="48" value="&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;- 式&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;　　-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;🟣&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;字面（式の字面）&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;　　-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;🟢&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;意味(aをb回足す操作)（字面の解釈のひとつ）= 解釈A（とする）&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;　　- 解釈B&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;　　- 解釈C&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;　　- ...&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;　　-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;🟠&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;値（計算結果）&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;　　- （順序派が言う）式の指すものは、&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;🔴&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;前者と&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;🔷&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;後者（一緒くたにしている。区別ができてない）&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;🔴&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;数学的対象（順序派の言う&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;🟠&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;値に近い）（≠計算結果,計算前の式）（前者。数学が等号などで扱う対象）&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;🔷&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;後者。_(?)_は、一意にすら定まらないもの&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#4D4D4D;" parent="1" vertex="1">
                    <mxGeometry x="40" y="530" width="540" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="49" value="ゲルくんの発言" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#1976D2;" parent="1" vertex="1">
                    <mxGeometry x="20" y="340" width="150" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="50" value="&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;私は一意に字面=意味(aをb回足す操作)だとは考えていない。いくつもある式の解釈の一つ。例えば、a×bは「aとbを掛ける」とも「aにbを掛ける」とも「bにaを掛ける」とも解釈できる。そう考えている。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;二つ目は、&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;🔴&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;数学的対象は順序派の言う値に近い。一方、&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;🔷&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;彼らの言う意味は、字面の解釈のひとつ。&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;🔴&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;前者は数学が等号などで扱う対象。&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;🔷&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;後者はそうではなく、一意にすら定まらないもの。これら二つを式の指すものとして一緒くたにしているので、「区別ができてない」と表現した。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;https://x.com/esuthi_v2/status/1959284415814570278&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#4D4D4D;" parent="1" vertex="1">
                    <mxGeometry x="40" y="370" width="540" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="51" value="&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;そうだね。異なる。ならば、それでキミの最初の&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;　　&amp;gt; 字面とそれが指す数学的対象の区別がついてないことが伺える。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;これは矛盾してない？字面=意味だとキミは考えていると思うから、区別がついていると思うけど&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;https://x.com/Ts_Neko/status/1959275053188866062&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#4D4D4D;" parent="1" vertex="1">
                    <mxGeometry x="40" y="260" width="540" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="52" value="T&#39;s-Nekoの発言" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#7B1FA2;" parent="1" vertex="1">
                    <mxGeometry x="20" y="170" width="120" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="53" value="&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&amp;gt; 順序派が言う「式が持つ情報は値と意味だ」というのは、式を(値,意味)の対だと見ると言うことでいいのかな？&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;式には🟠値（計算結果）と&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;🟢&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;意味（計算する前の式）の両方の側面はあるね。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;https://x.com/Ts_Neko/status/1959269272301027668&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#4D4D4D;" parent="1" vertex="1">
                    <mxGeometry x="40" y="200" width="580" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="54" value="構造" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=light-dark(#5aa31f, #efa0ff);" parent="1" vertex="1">
                    <mxGeometry x="30" y="500" width="120" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="56" style="edgeStyle=none;html=1;fontSize=16;fontColor=#000000;strokeColor=#0000FF;endArrow=none;endFill=0;startArrow=none;startFill=0;strokeWidth=3;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="540" y="645" as="targetPoint"/>
                        <mxPoint x="330" y="645" as="sourcePoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="57" value="ゲルくんの発言" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#1976D2;" parent="1" vertex="1">
                    <mxGeometry x="20" y="40" width="150" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="58" value="&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;SUO&amp;gt; 「3+3+3+3」と「4+4+4」は、見てのとおり別物&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;「見てのとおり」と言っているから、&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;🟣&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;字面とそれが指す&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;🔴&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;数学的対象の区別がついてないことが伺える。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;3+3+3+3も4+4+4も、12が指す数学的対象と同一のものを指す。別物ではない。&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;https://x.com/esuthi_v2/status/1958826105713938484&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#4D4D4D;" parent="1" vertex="1">
                    <mxGeometry x="40" y="70" width="540" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
