                <mxCell id="110" value="字面や意味を計算結果であると誤って認識している" style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#9673a6;fillColor=#e1d5e7;fontFamily=Helvetica;fontSize=12;fontStyle=0;spacingLeft=8;rounded=1;arcSize=50;" vertex="1" parent="1">
