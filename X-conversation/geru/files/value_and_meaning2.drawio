                <mxCell id="127" value="それらとは？" style="text;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#7B1FA2;fontStyle=1;" vertex="1" parent="1">
