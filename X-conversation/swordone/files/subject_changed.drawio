                <mxCell id="72" value="&lt;span style=&quot;font-size: 11px;&quot;&gt;メインの文&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#4D4D4D;" parent="1" vertex="1">
